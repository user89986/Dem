<Window x:Class="WpfApp1.AddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        FontFamily="Times New Roman"
        mc:Ignorable="d"
        Title="Добавить товар" Height="450" Width="400" Icon="/Icon.ico">
    <Grid>

        <TextBlock HorizontalAlignment="Left" Margin="10,64,0,0" TextWrapping="Wrap" Text="Артикул" VerticalAlignment="Top"/>
        <TextBox x:Name="ProductIdtxt" HorizontalAlignment="Left" Margin="10,85,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,114,0,0" TextWrapping="Wrap" Text="Название продукта" VerticalAlignment="Top"/>
        <TextBox x:Name="ProductNametxt" HorizontalAlignment="Left" Margin="10,135,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,166,0,0" TextWrapping="Wrap" Text="Единица измерения" VerticalAlignment="Top"/>
        <TextBox x:Name="Unittxt" HorizontalAlignment="Left" Margin="10,187,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,216,0,0" TextWrapping="Wrap" Text="Цена" VerticalAlignment="Top"/>
        <TextBox x:Name="Pricetxt" HorizontalAlignment="Left" Margin="10,237,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,266,0,0" TextWrapping="Wrap" Text="Поставщик" VerticalAlignment="Top"/>
        <TextBox x:Name="Importertxt" HorizontalAlignment="Left" Margin="10,287,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="10,321,0,0" TextWrapping="Wrap" Text="Производитель" VerticalAlignment="Top"/>
        <TextBox x:Name="Creatertxt" HorizontalAlignment="Left" Margin="10,342,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="237,64,0,0" TextWrapping="Wrap" Text="Категория" VerticalAlignment="Top"/>
        <TextBox x:Name="Categorytxt" HorizontalAlignment="Left" Margin="237,85,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="237,114,0,0" TextWrapping="Wrap" Text="Скидка" VerticalAlignment="Top"/>
        <TextBox x:Name="Saletxt" HorizontalAlignment="Left" Margin="237,135,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="237,166,0,0" TextWrapping="Wrap" Text="Кол-во на складе" VerticalAlignment="Top"/>
        <TextBox x:Name="Quantitytxt" HorizontalAlignment="Left" Margin="237,187,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="237,216,0,0" TextWrapping="Wrap" Text="Описание" VerticalAlignment="Top"/>
        <TextBox x:Name="Infotxt" HorizontalAlignment="Left" Margin="237,237,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBlock HorizontalAlignment="Left" Margin="237,266,0,0" TextWrapping="Wrap" Text="Фото" VerticalAlignment="Top"/>
        <TextBox x:Name="Imagetxt" HorizontalAlignment="Left" Margin="237,287,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Button Content="Сохранить" HorizontalAlignment="Left" Margin="122,390,0,0" VerticalAlignment="Top" Width="134" Background="Chartreuse" Click="Button_Click_1"/>
        <Button Content="Главное меню" HorizontalAlignment="Left" Margin="313,406,0,0" VerticalAlignment="Top" Width="77" Background="Chartreuse" Click="Button_Click"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap" Text="Добавить товар" VerticalAlignment="Top" Height="17" Width="80"/>


    </Grid>
</Window>
