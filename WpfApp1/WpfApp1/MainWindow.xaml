<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        FontFamily="Times New Roman"
        mc:Ignorable="d"
        Title="Каталог" Height="450" Width="800" Icon="/Icon.ico">
    <Grid>

        <Grid Margin="0,0,387,0">
            <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="Каталог товаров" VerticalAlignment="Top" FontSize="16" Height="23" Width="184"/>
            <TextBlock x:Name="fiotxt" HorizontalAlignment="Left" Margin="10,33,0,0" TextWrapping="Wrap" Text="Гость" VerticalAlignment="Top" Width="319" Height="14"/>
            <TextBlock x:Name="Roletxt" HorizontalAlignment="Left" Margin="10,47,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="367" Height="19"/>
            <Button Content="Выйти с учетной записи" HorizontalAlignment="Left" Margin="220,10,0,0" VerticalAlignment="Top" Width="157" Height="22" Background="Chartreuse" Click="Button_Click_1"/>



        </Grid>
        <Grid x:Name="Admingrd" Margin="418,0,0,358" Visibility="Hidden">
            <Button Content="Добавить" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="126" Background="Chartreuse" Click="Button_Click"/>

        </Grid>
        <Grid Margin="0,81,0,0">
            <ScrollViewer>
                <Grid>
                    <ItemsControl Margin="0,0,0,200" ItemsSource="{Binding Products}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="153">
                                    <Border BorderBrush="Black" BorderThickness="1"/>
                                    <Image Source ="{Binding ImageFullPath}"  HorizontalAlignment="Left" Height="100" Margin="10,10,0,0" VerticalAlignment="Top" Width="100"/>
                                    <TextBlock HorizontalAlignment="Left" Margin="130,8,0,0" TextWrapping="Wrap" Text="{Binding Category.CategoryName}" VerticalAlignment="Top" Width="114"/>
                                    <TextBlock HorizontalAlignment="Left" Margin="271,8,0,0" TextWrapping="Wrap" Text="{Binding ProductName.ProductType}" VerticalAlignment="Top" Width="277"/>
                                    <TextBlock HorizontalAlignment="Left" Margin="130,29,0,0" TextWrapping="Wrap" Text="{Binding Info}" VerticalAlignment="Top" Width="471"/>
                                    <TextBlock HorizontalAlignment="Left" Margin="130,51,0,0" TextWrapping="Wrap" Text="{Binding Creater.CreaterName}" VerticalAlignment="Top" Width="471"/>
                                    <TextBlock HorizontalAlignment="Left" Margin="130,72,0,0" TextWrapping="Wrap" Text="{Binding Importer.ImporterName}" VerticalAlignment="Top" Width="471"/>
                                    <TextBlock HorizontalAlignment="Left" Margin="130,93,0,0" TextWrapping="Wrap" Text="{Binding Price,StringFormat=Цена {0}}" VerticalAlignment="Top" Width="471"/>
                                    <TextBlock HorizontalAlignment="Left" Margin="130,114,0,0" TextWrapping="Wrap" Text="{Binding Unit.UnitName}" VerticalAlignment="Top" Width="482"/>
                                    <TextBlock HorizontalAlignment="Left" Margin="130,135,0,0" TextWrapping="Wrap" Text="{Binding Quantity.QuantityName, StringFormat=Кол-во на складе: {0}}" VerticalAlignment="Top" Width="482"/>
                                    <TextBlock HorizontalAlignment="Left" Margin="636,56,0,0" TextWrapping="Wrap" Text="{Binding Sale,StringFormat=Скидка {0}}" VerticalAlignment="Top" Width="114"/>

                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </Grid>
            </ScrollViewer>

        </Grid>

    </Grid>
</Window>
